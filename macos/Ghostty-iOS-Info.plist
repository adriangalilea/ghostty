<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- vigil for iPhone. Xcode merges the generated keys (bundle name,
	     version, scene manifest) over this file: only what the generator
	     cannot express lives here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.adriangalilea.vigil</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vigil</string>
			</array>
		</dict>
	</array>
	<!-- tether's listeners (_tether._udp): the Macs' sessions (vigil/1) and
	     their requests (authz) reach this phone directly on a shared
	     network, through the relay otherwise. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_tether._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>vigil reaches your Macs directly when you share a network with them.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID confirms an answer before it is signed.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
